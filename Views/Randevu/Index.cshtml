@using VeterinerKlinikSistemi.Services
@model List<Randevu>
@{
    var adminMi = User.IsInRole(Roller.Admin);
    var veterinerMi = User.IsInRole(Roller.Veteriner);
    var uyeMi = !adminMi && !veterinerMi;
    var seciliDurum = ViewBag.SeciliDurum as RandevuDurumu?;
    ViewData["Title"] = adminMi ? "Randevular" : "Randevularım";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0">@ViewData["Title"]</h2>
        <p class="text-muted small mb-0">
            @if (adminMi)
            {
                <span>Sistemdeki tüm randevuları görüntüleyin, onaylayın veya yönetin.</span>
            }
            else if (veterinerMi)
            {
                <span>Size alınan randevuları onaylayabilir, reddedebilir ve tamamlanan muayenelere not girebilirsiniz.</span>
            }
            else
            {
                <span>Evcil dostlarınız için aldığınız randevuları ve onay durumlarını takip edin.</span>
            }
        </p>
    </div>

    @if (adminMi || uyeMi)
    {
        <a asp-action="Create" class="btn btn-kaplan rounded-pill px-4 fw-semibold">Yeni Randevu Al</a>
    }
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-action="Index" class="btn btn-sm rounded-pill px-3 @(seciliDurum == null ? "btn-kaplan" : "btn-outline-kaplan")">Tümü</a>
    @foreach (RandevuDurumu d in Enum.GetValues<RandevuDurumu>())
    {
        <a asp-action="Index" asp-route-durum="@d" class="btn btn-sm rounded-pill px-3 @(seciliDurum == d ? "btn-kaplan" : "btn-outline-kaplan")">
            @RandevuService.DurumMetni(d)
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="bg-white border rounded-4 p-5 text-center text-muted shadow-sm">
        <h5 class="fw-bold text-dark mb-2">Kayıtlı randevu bulunamadı</h5>
        <p class="small mb-3">Seçili duruma ait randevu kaydı görünmüyor.</p>
        @if (adminMi || uyeMi)
        {
            <a asp-action="Create" class="btn btn-kaplan rounded-pill px-4">Randevu Oluştur</a>
        }
    </div>
}
else
{
    <div class="bg-white border rounded-4 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Tarih / Saat</th>
                        <th>Evcil Hayvan</th>
                        <th>Hizmet</th>
                        <th>Veteriner Hekim</th>
                        <th>Durum</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var bitis = r.BaslangicZamani.AddMinutes(r.SureDakika);
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@r.BaslangicZamani.ToString("dd.MM.yyyy")</div>
                                <div class="small text-muted">@r.BaslangicZamani.ToString("HH:mm") – @bitis.ToString("HH:mm") (@r.SureDakika dk)</div>
                            </td>
                            <td>
                                <a asp-controller="EvcilHayvan" asp-action="Details" asp-route-id="@r.EvcilHayvanId" class="fw-semibold text-dark text-decoration-none">
                                    @r.EvcilHayvan?.Ad
                                </a>
                                <div class="small text-muted">
                                    @r.EvcilHayvan?.Tur
                                    @if ((adminMi || veterinerMi) && r.EvcilHayvan?.Sahip != null)
                                    {
                                        <span> · @r.EvcilHayvan.Sahip.AdSoyad</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold">@r.Hizmet?.Ad</div>
                                <div class="small text-kaplan fw-semibold">@r.Ucret.ToString("N2") ₺</div>
                            </td>
                            <td>@r.Veteriner?.AdSoyad</td>
                            <td>
                                <span class="badge rounded-pill px-3 py-2 @RandevuService.DurumRozetSinifi(r.Durum)">
                                    @RandevuService.DurumMetni(r.Durum)
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                    <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Detay</a>

                                    @if ((adminMi || veterinerMi) && r.Durum == RandevuDurumu.Bekliyor)
                                    {
                                        <form asp-action="Onayla" asp-route-id="@r.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">Onayla</button>
                                        </form>
                                        <form asp-action="Reddet" asp-route-id="@r.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Reddet</button>
                                        </form>
                                    }

                                    @if ((adminMi || veterinerMi) && (r.Durum == RandevuDurumu.Onaylandi || r.Durum == RandevuDurumu.Tamamlandi))
                                    {
                                        <a asp-action="MuayeneNotu" asp-route-id="@r.Id" class="btn btn-sm btn-kaplan rounded-pill px-3">
                                            @(r.Durum == RandevuDurumu.Tamamlandi ? "Notu Düzenle" : "Muayene Notu")
                                        </a>
                                    }

                                    @if ((adminMi || uyeMi) && (adminMi || r.Durum == RandevuDurumu.Bekliyor))
                                    {
                                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-kaplan rounded-pill px-3">Düzenle</a>
                                    }

                                    @if (r.Durum == RandevuDurumu.Bekliyor || r.Durum == RandevuDurumu.Onaylandi)
                                    {
                                        <form asp-action="IptalEt" asp-route-id="@r.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3">İptal</button>
                                        </form>
                                    }

                                    @if ((adminMi || uyeMi) && (adminMi || r.Durum != RandevuDurumu.Tamamlandi))
                                    {
                                        <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Sil</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
