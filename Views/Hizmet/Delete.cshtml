@model Hizmet
@{
    ViewData["Title"] = "Hizmeti Sil";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="bg-white border border-danger-subtle rounded-4 p-4 p-md-5 shadow-sm">
            <h3 class="fw-bold text-danger mb-2">Hizmeti Silmek İstediğinize Emin Misiniz?</h3>
            <p class="text-muted small mb-4">Bu işlem geri alınamaz. Bu hizmete ait randevu varsa silme işlemine izin verilmez.</p>

            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">Klinik</dt>
                <dd class="col-sm-8">@Model.Klinik?.Ad</dd>

                <dt class="col-sm-4 text-muted">Hizmet Adı</dt>
                <dd class="col-sm-8 fw-bold">@Model.Ad</dd>

                <dt class="col-sm-4 text-muted">Süre</dt>
                <dd class="col-sm-8">@Model.SureDakika dakika</dd>

                <dt class="col-sm-4 text-muted">Ücret</dt>
                <dd class="col-sm-8 fw-semibold text-kaplan">@Model.Ucret.ToString("N2") ₺</dd>
            </dl>

            <form asp-action="Delete" method="post" class="d-flex gap-2">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">Evet, Sil</button>
                <a asp-action="Index" class="btn btn-outline-kaplan rounded-pill px-4">İptal</a>
            </form>
        </div>
    </div>
</div>
