@using VeterinerKlinikSistemi.Services
@model List<EvcilHayvan>
@{
    var tumKayitlar = User.IsInRole(Roller.Admin) || User.IsInRole(Roller.Veteriner);
    var duzenlemeYetkisi = ViewBag.DuzenlemeYetkisi as bool? ?? false;
    var arama = ViewBag.Arama as string;
    ViewData["Title"] = tumKayitlar ? "Evcil Hayvanlar" : "Evcil Hayvanlarım";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-0">@ViewData["Title"]</h2>
        <p class="text-muted small mb-0">
            @(tumKayitlar
                ? "Sistemde kayıtlı tüm klasik ve egzotik evcil hayvanları görüntüleyin."
                : "Kayıtlı evcil dostlarınızı görüntüleyebilir, yeni dost ekleyebilir ve bilgilerini güncelleyebilirsiniz.")
        </p>
    </div>

    @if (duzenlemeYetkisi)
    {
        <a asp-action="Create" class="btn btn-kaplan rounded-pill px-4 fw-semibold">Yeni Evcil Hayvan Ekle</a>
    }
</div>

<form asp-action="Index" method="get" class="bg-white border rounded-4 p-3 shadow-sm mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-9">
            <input type="text" name="arama" value="@arama" class="form-control" placeholder="Ad, tür veya ırk ara (örn: Pamuk, Kedi, Egzotik)..." />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-kaplan rounded-pill px-4 flex-grow-1">Ara</button>
            @if (!string.IsNullOrWhiteSpace(arama))
            {
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Temizle</a>
            }
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="bg-white border rounded-4 p-5 text-center text-muted shadow-sm">
        <h5 class="fw-bold text-dark mb-2">Henüz kayıtlı evcil hayvan bulunmuyor</h5>
        <p class="small mb-3">
            @(duzenlemeYetkisi
                ? "İlk evcil hayvanınızı ekleyerek aşı takvimi ve randevu takibine başlayabilirsiniz."
                : "Arama kriterinize uygun kayıt bulunamadı.")
        </p>
        @if (duzenlemeYetkisi)
        {
            <a asp-action="Create" class="btn btn-kaplan rounded-pill px-4">Evcil Hayvan Ekle</a>
        }
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var hayvan in Model)
        {
            var basHarf = string.IsNullOrWhiteSpace(hayvan.Ad) ? "?" : hayvan.Ad[0].ToString().ToUpper();

            <div class="col-md-6 col-lg-4">
                <div class="bg-white border rounded-4 overflow-hidden shadow-sm h-100 d-flex flex-column">
                    @if (!string.IsNullOrWhiteSpace(hayvan.FotografYolu))
                    {
                        <img src="@hayvan.FotografYolu" alt="@hayvan.Ad" class="w-100" style="height: 190px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="clinic-panel rounded-0 d-flex align-items-center justify-content-between px-4 py-3" style="height: 110px;">
                            <div>
                                <span class="badge bg-white text-kaplan rounded-pill px-3 py-1 mb-1">@hayvan.Tur</span>
                                <h5 class="fw-bold text-white mb-0">@hayvan.Ad</h5>
                            </div>
                            <div class="vet-avatar" style="width: 52px; height: 52px; font-size: 1.25rem;">@basHarf</div>
                        </div>
                    }

                    <div class="p-4 flex-grow-1 d-flex flex-column justify-content-between gap-3">
                        <div>
                            @if (!string.IsNullOrWhiteSpace(hayvan.FotografYolu))
                            {
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h5 class="fw-bold text-dark mb-0">@hayvan.Ad</h5>
                                    <span class="pill-tag">@hayvan.Tur</span>
                                </div>
                            }

                            <div class="small text-muted mb-2">
                                <strong>Irk:</strong> @hayvan.Irk
                            </div>

                            <div class="d-flex flex-wrap gap-2 small mb-2">
                                <span class="badge bg-light text-dark border">Yaş: @EvcilHayvanService.YasMetni(hayvan.DogumTarihi)</span>
                                <span class="badge bg-light text-dark border">@hayvan.Kilo.ToString("0.##") kg</span>
                                <span class="badge bg-light text-dark border">@hayvan.AsiKayitlari.Count Aşı</span>
                            </div>

                            @if (tumKayitlar && hayvan.Sahip != null)
                            {
                                <div class="small text-muted mt-2">
                                    Sahibi: <strong class="text-dark">@hayvan.Sahip.AdSoyad</strong>
                                </div>
                            }
                        </div>

                        <div class="d-flex flex-wrap justify-content-end gap-1 border-top pt-3">
                            <a asp-action="Details" asp-route-id="@hayvan.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Detay</a>
                            @if (duzenlemeYetkisi)
                            {
                                <a asp-action="Edit" asp-route-id="@hayvan.Id" class="btn btn-sm btn-outline-kaplan rounded-pill px-3">Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@hayvan.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Sil</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
