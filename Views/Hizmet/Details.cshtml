@model Hizmet
@{
    ViewData["Title"] = "Hizmet Detayı";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="bg-white border rounded-4 p-4 p-md-5 shadow-sm">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <span class="pill-tag mb-2">@Model.Klinik?.Ad</span>
                    <h2 class="fw-bold text-dark mb-1">@Model.Ad</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.Aciklama))
                    {
                        <p class="text-muted mb-0">@Model.Aciklama</p>
                    }
                </div>
                <div class="text-end">
                    <div class="fs-2 fw-bold text-kaplan">@Model.Ucret.ToString("N2") ₺</div>
                    <span class="badge bg-light text-secondary border">@Model.SureDakika dakika</span>
                </div>
            </div>

            <hr class="my-4" />

            <h5 class="fw-bold mb-3">Bu Hizmeti Verebilen Veteriner Hekimler</h5>
            @if (Model.VeterinerHizmetler.Any())
            {
                <div class="d-flex flex-wrap gap-2 mb-4">
                    @foreach (var vh in Model.VeterinerHizmetler)
                    {
                        if (vh.Veteriner != null)
                        {
                            <span class="pill-tag">@vh.Veteriner.AdSoyad</span>
                        }
                    }
                </div>
            }
            else
            {
                <p class="text-muted small mb-4">Bu hizmet için henüz veteriner hekim ataması yapılmamış.</p>
            }

            <div class="d-flex gap-2">
                @if (User.IsInRole(Roller.Admin))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-kaplan rounded-pill px-4">Düzenle</a>
                }
                <a asp-action="Index" class="btn btn-outline-kaplan rounded-pill px-4">Hizmetlere Dön</a>
            </div>
        </div>
    </div>
</div>
