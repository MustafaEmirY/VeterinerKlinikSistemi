@model Klinik
@{
    ViewData["Title"] = "Kliniği Sil";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="bg-white border border-danger-subtle rounded-4 p-4 p-md-5 shadow-sm">
            <h3 class="fw-bold text-danger mb-2">Kliniği Silmek İstediğinize Emin Misiniz?</h3>
            <p class="text-muted small mb-4">Bu işlem geri alınamaz. Bağlı hizmet veya hekim kaydı varsa silme işlemine izin verilmez.</p>

            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">Klinik Adı</dt>
                <dd class="col-sm-8 fw-bold">@Model.Ad</dd>

                <dt class="col-sm-4 text-muted">Çalışma Saatleri</dt>
                <dd class="col-sm-8">@Model.AcilisSaati.ToString("HH:mm") – @Model.KapanisSaati.ToString("HH:mm")</dd>

                <dt class="col-sm-4 text-muted">Telefon</dt>
                <dd class="col-sm-8">@Model.Telefon</dd>

                <dt class="col-sm-4 text-muted">Adres</dt>
                <dd class="col-sm-8">@Model.Adres</dd>
            </dl>

            <form asp-action="Delete" method="post" class="d-flex gap-2">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">Evet, Sil</button>
                <a asp-action="Index" class="btn btn-outline-kaplan rounded-pill px-4">İptal</a>
            </form>
        </div>
    </div>
</div>
