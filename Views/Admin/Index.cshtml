@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="clinic-panel p-4 p-md-5 mb-4 shadow-sm">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <span class="badge bg-white text-kaplan rounded-pill px-3 py-2 mb-2">Yönetim Merkezi</span>
            <h2 class="fw-bold mb-1">Admin Paneli</h2>
            <p class="small opacity-75 mb-0">Kaplan Veteriner Kliniği sistem kayıtlarını ve modüllerini buradan yönetebilirsiniz.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Klinik" asp-action="Create" class="btn btn-kaplan rounded-pill px-3 fw-semibold">Yeni Klinik Ekle</a>
            <a asp-controller="Hizmet" asp-action="Create" class="btn btn-outline-light rounded-pill px-3">Yeni Hizmet Ekle</a>
            <a asp-controller="Veteriner" asp-action="Create" class="btn btn-outline-light rounded-pill px-3">Yeni Veteriner Ekle</a>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg-2">
        <div class="bg-white border rounded-4 p-3 shadow-sm h-100">
            <div class="small text-muted">Klinikler</div>
            <div class="fs-3 fw-bold text-kaplan">@Model.KlinikSayisi</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="bg-white border rounded-4 p-3 shadow-sm h-100">
            <div class="small text-muted">Hizmetler</div>
            <div class="fs-3 fw-bold text-kaplan">@Model.HizmetSayisi</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="bg-white border rounded-4 p-3 shadow-sm h-100">
            <div class="small text-muted">Veterinerler</div>
            <div class="fs-3 fw-bold text-dark">@Model.VeterinerSayisi</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="bg-white border rounded-4 p-3 shadow-sm h-100">
            <div class="small text-muted">Evcil Hayvanlar</div>
            <div class="fs-3 fw-bold text-dark">@Model.EvcilHayvanSayisi</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="bg-white border rounded-4 p-3 shadow-sm h-100">
            <div class="small text-muted">Bekleyen / Toplam</div>
            <div class="fs-3 fw-bold text-dark">@Model.BekleyenRandevuSayisi / @Model.ToplamRandevuSayisi</div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="bg-white border rounded-4 p-3 shadow-sm h-100">
            <div class="small text-muted">Kullanıcılar</div>
            <div class="fs-3 fw-bold text-dark">@Model.KullaniciSayisi</div>
        </div>
    </div>
</div>

<h4 class="fw-bold mb-3">Yönetim Modülleri</h4>
<div class="row g-3">
    <div class="col-md-4">
        <div class="service-row p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <h5 class="fw-bold text-dark mb-1">Klinik Yönetimi</h5>
                <p class="text-muted small mb-3">Klinik şubelerini, çalışma saatlerini, adres ve iletişim bilgilerini görüntüleyin ve güncelleyin.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Klinik" asp-action="Index" class="btn btn-sm btn-kaplan rounded-pill px-3">Klinikleri Listele</a>
                <a asp-controller="Klinik" asp-action="Create" class="btn btn-sm btn-outline-kaplan rounded-pill px-3">Yeni Ekle</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="service-row p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <h5 class="fw-bold text-dark mb-1">Hizmet Yönetimi</h5>
                <p class="text-muted small mb-3">Muayene, aşı, kısırlaştırma ve bakım hizmetlerinin süre ve ücret bilgilerini düzenleyin.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Hizmet" asp-action="Index" class="btn btn-sm btn-kaplan rounded-pill px-3">Hizmetleri Listele</a>
                <a asp-controller="Hizmet" asp-action="Create" class="btn btn-sm btn-outline-kaplan rounded-pill px-3">Yeni Ekle</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="service-row p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <h5 class="fw-bold text-dark mb-1">Veteriner Yönetimi</h5>
                <p class="text-muted small mb-3">Hekim tanımlama, uzmanlık alanları, hizmet eşleştirmesi ve müsaitlik saatleri yönetimi.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Veteriner" asp-action="Index" class="btn btn-sm btn-kaplan rounded-pill px-3">Hekimleri Listele</a>
                <a asp-controller="Veteriner" asp-action="Create" class="btn btn-sm btn-outline-kaplan rounded-pill px-3">Yeni Ekle</a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="service-row p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <h5 class="fw-bold text-dark mb-1">Evcil Hayvan Yönetimi</h5>
                <p class="text-muted small mb-3">
                    Sistemdeki tüm klasik ve egzotik hayvan kayıtlarını (@Model.EvcilHayvanSayisi) yönetin. Aşı kayıtları (@Model.AsiKaydiSayisi) modülü bir sonraki günde eklenecek.
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="EvcilHayvan" asp-action="Index" class="btn btn-sm btn-kaplan rounded-pill px-3">Hayvanları Listele</a>
                <a asp-controller="EvcilHayvan" asp-action="Create" class="btn btn-sm btn-outline-kaplan rounded-pill px-3">Yeni Ekle</a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="bg-white border rounded-4 p-3 h-100">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <h6 class="fw-bold mb-0">Randevu &amp; Raporlama</h6>
                <span class="badge bg-light text-secondary border">Sonraki Adım</span>
            </div>
            <p class="text-muted small mb-0">Randevu onay/red akışı, muayene notları ve REST API ciro raporları.</p>
        </div>
    </div>
</div>
