@model Hizmet
@{
    ViewData["Title"] = "Yeni Hizmet Ekle";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="bg-white border rounded-4 p-4 p-md-5 shadow-sm">
            <h3 class="fw-bold text-kaplan mb-1">Yeni Hizmet Ekle</h3>
            <p class="text-muted small mb-4">Kliniğe ait hizmet adı, süre ve ücret bilgilerini giriniz.</p>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="KlinikId" class="form-label fw-semibold"></label>
                    <select asp-for="KlinikId" asp-items="ViewBag.Klinikler" class="form-select">
                        <option value="">Klinik Seçiniz</option>
                    </select>
                    <span asp-validation-for="KlinikId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Ad" class="form-label fw-semibold"></label>
                    <input asp-for="Ad" class="form-control" placeholder="Örn: Mikroçip Uygulaması" />
                    <span asp-validation-for="Ad" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Aciklama" class="form-label fw-semibold"></label>
                    <textarea asp-for="Aciklama" class="form-control" rows="2" placeholder="Hizmet hakkında kısa açıklama"></textarea>
                    <span asp-validation-for="Aciklama" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <label asp-for="SureDakika" class="form-label fw-semibold"></label>
                        <input asp-for="SureDakika" type="number" class="form-control" />
                        <span asp-validation-for="SureDakika" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Ucret" class="form-label fw-semibold"></label>
                        <input asp-for="Ucret" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="Ucret" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-kaplan rounded-pill px-4 fw-semibold">Kaydet</button>
                    <a asp-action="Index" class="btn btn-outline-kaplan rounded-pill px-4">Vazgeç</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
