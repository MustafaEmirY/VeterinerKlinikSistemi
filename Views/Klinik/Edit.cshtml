@model Klinik
@{
    ViewData["Title"] = "Kliniği Düzenle";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="bg-white border rounded-4 p-4 p-md-5 shadow-sm">
            <h3 class="fw-bold text-kaplan mb-1">Kliniği Düzenle</h3>
            <p class="text-muted small mb-4">Klinik bilgilerini güncelleyebilirsiniz.</p>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Ad" class="form-label fw-semibold"></label>
                    <input asp-for="Ad" class="form-control" />
                    <span asp-validation-for="Ad" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Adres" class="form-label fw-semibold"></label>
                    <textarea asp-for="Adres" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Adres" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Telefon" class="form-label fw-semibold"></label>
                    <input asp-for="Telefon" class="form-control" />
                    <span asp-validation-for="Telefon" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <label asp-for="AcilisSaati" class="form-label fw-semibold"></label>
                        <input asp-for="AcilisSaati" type="time" class="form-control" value="@Model.AcilisSaati.ToString("HH:mm")" />
                        <span asp-validation-for="AcilisSaati" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="KapanisSaati" class="form-label fw-semibold"></label>
                        <input asp-for="KapanisSaati" type="time" class="form-control" value="@Model.KapanisSaati.ToString("HH:mm")" />
                        <span asp-validation-for="KapanisSaati" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-kaplan rounded-pill px-4 fw-semibold">Güncelle</button>
                    <a asp-action="Index" class="btn btn-outline-kaplan rounded-pill px-4">Vazgeç</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
