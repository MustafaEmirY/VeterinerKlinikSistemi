@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center py-4 mb-4 bg-light rounded-3 border">
    <h1 class="display-5 fw-bold">Veteriner Kliniği Randevu ve Hasta Takip Sistemi</h1>
    <p class="lead text-muted mx-auto" style="max-width: 700px;">
        Veteriner klinikleri, hekimler, evcil hayvanların muayene ve aşı geçmişleri ile randevu süreçlerini tek bir yerden yönetin.
    </p>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Hizmetler &amp; Hekimler</h5>
                <p class="card-text">
                    Kliniklerin sunduğu muayene, aşı ve bakım hizmetleri ile veteriner hekimlerin uzmanlık alanları ve müsaitlik saatleri tanımlanır.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Evcil Hayvan &amp; Aşı Takibi</h5>
                <p class="card-text">
                    Hayvan sahipleri evcil hayvanlarını sisteme kaydedebilir, geçmiş aşılarını, sonraki doz tarihlerini ve muayene notlarını takip edebilir.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Randevu Sistemi</h5>
                <p class="card-text">
                    Hekim müsaitliği ve hizmet süresine göre çakışma kontrolü yapılarak uygun zaman aralıklarına randevu oluşturulur ve onaylanır.
                </p>
            </div>
        </div>
    </div>
</div>
