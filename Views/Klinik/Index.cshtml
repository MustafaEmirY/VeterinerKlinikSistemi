@model List<Klinik>
@{
    ViewData["Title"] = "Klinikler";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h2 class="fw-bold mb-0">Klinikler</h2>
        <p class="text-muted small mb-0">Sistemde kayıtlı veteriner kliniklerini yönetin.</p>
    </div>
    <a asp-action="Create" class="btn btn-kaplan rounded-pill px-4 fw-semibold">Yeni Klinik Ekle</a>
</div>

@if (!Model.Any())
{
    <div class="bg-white border rounded-4 p-4 text-center text-muted">
        Henüz kayıtlı klinik bulunmamaktadır.
    </div>
}
else
{
    <div class="bg-white border rounded-4 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Klinik Adı</th>
                        <th>Çalışma Saatleri</th>
                        <th>Telefon</th>
                        <th>Hizmet</th>
                        <th>Hekim</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var klinik in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@klinik.Ad</div>
                                <div class="small text-muted">@klinik.Adres</div>
                            </td>
                            <td>
                                <span class="pill-tag">@klinik.AcilisSaati.ToString("HH:mm") – @klinik.KapanisSaati.ToString("HH:mm")</span>
                            </td>
                            <td>@klinik.Telefon</td>
                            <td><span class="badge bg-light text-dark border">@klinik.Hizmetler.Count</span></td>
                            <td><span class="badge bg-light text-dark border">@klinik.Veterinerler.Count</span></td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@klinik.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Detay</a>
                                    <a asp-action="Edit" asp-route-id="@klinik.Id" class="btn btn-sm btn-outline-kaplan rounded-pill px-3">Düzenle</a>
                                    <a asp-action="Delete" asp-route-id="@klinik.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Sil</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
