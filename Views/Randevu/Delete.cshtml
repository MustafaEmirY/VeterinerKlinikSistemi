@using VeterinerKlinikSistemi.Services
@model Randevu
@{
    ViewData["Title"] = "Randevuyu Sil";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="bg-white border border-danger-subtle rounded-4 p-4 p-md-5 shadow-sm">
            <h3 class="fw-bold text-danger mb-2">Randevuyu Silmek İstediğinize Emin Misiniz?</h3>
            <p class="text-muted small mb-4">Bu işlem geri alınamaz.</p>

            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted">Evcil Hayvan</dt>
                <dd class="col-sm-8 fw-bold">@Model.EvcilHayvan?.Ad</dd>

                <dt class="col-sm-4 text-muted">Hizmet</dt>
                <dd class="col-sm-8">@Model.Hizmet?.Ad (@Model.SureDakika dk · @Model.Ucret.ToString("N2") ₺)</dd>

                <dt class="col-sm-4 text-muted">Veteriner Hekim</dt>
                <dd class="col-sm-8">@Model.Veteriner?.AdSoyad</dd>

                <dt class="col-sm-4 text-muted">Tarih / Saat</dt>
                <dd class="col-sm-8">@Model.BaslangicZamani.ToString("dd.MM.yyyy HH:mm")</dd>

                <dt class="col-sm-4 text-muted">Durum</dt>
                <dd class="col-sm-8">@RandevuService.DurumMetni(Model.Durum)</dd>
            </dl>

            <form asp-action="Delete" method="post" class="d-flex gap-2">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">Evet, Sil</button>
                <a asp-action="Index" class="btn btn-outline-kaplan rounded-pill px-4">İptal</a>
            </form>
        </div>
    </div>
</div>
